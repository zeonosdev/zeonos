/*
 * ZeonOS - I/O Operations
 * kernel/io/ports.c
 * 
 * Port I/O operations (in/out)
 */

#include "../../kernel.h"

/**
 * Read byte from port
 */
uint8_t io_inb(uint16_t port) {
    uint8_t result;
    __asm__("inb %1, %0" : "=a"(result) : "dN"(port));
    return result;
}

/**
 * Write byte to port
 */
void io_outb(uint16_t port, uint8_t value) {
    __asm__("outb %1, %0" : : "dN"(port), "a"(value));
}

/**
 * Read word from port
 */
uint16_t io_inw(uint16_t port) {
    uint16_t result;
    __asm__("inw %1, %0" : "=a"(result) : "dN"(port));
    return result;
}

/**
 * Write word to port
 */
void io_outw(uint16_t port, uint16_t value) {
    __asm__("outw %1, %0" : : "dN"(port), "a"(value));
}

/**
 * Read dword from port
 */
uint32_t io_ind(uint16_t port) {
    uint32_t result;
    __asm__("inl %1, %0" : "=a"(result) : "dN"(port));
    return result;
}

/**
 * Write dword to port
 */
void io_outd(uint16_t port, uint32_t value) {
    __asm__("outl %1, %0" : : "dN"(port), "a"(value));
}
